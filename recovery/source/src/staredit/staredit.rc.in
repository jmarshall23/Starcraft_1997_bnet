    LTEXT "Resource / score / switch:", IDC_CONDITION_CATEGORY_LABEL, 8, 154, 96, 8
    COMBOBOX IDC_CONDITION_CATEGORY, 108, 151, 264, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
