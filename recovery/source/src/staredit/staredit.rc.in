    DEFPUSHBUTTON "OK", IDOK, 224, 196, 62, 14
    PUSHBUTTON "Cancel", IDCANCEL, 292, 196, 62, 14
END

IDD_TRIGGERS DIALOGEX 0, 0, 700, 318
