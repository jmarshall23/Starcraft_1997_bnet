IDD_TRIGGER_CONDITION DIALOGEX 0, 0, 382, 258
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Condition"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "Condition type:", IDC_STATIC, 8, 10, 92, 8
    COMBOBOX IDC_CONDITION_TYPE, 108, 7, 264, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Location ID:", IDC_CONDITION_LOCATION_LABEL, 8, 34, 96, 8
    COMBOBOX IDC_CONDITION_LOCATION, 108, 31, 264, 130, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
