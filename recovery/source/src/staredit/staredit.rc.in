    COMBOBOX IDC_CONDITION_PLAYER, 108, 55, 264, 130, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Amount / value:", IDC_CONDITION_AMOUNT_LABEL, 8, 82, 96, 8
    EDITTEXT IDC_CONDITION_AMOUNT, 108, 79, 264, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Unit / group:", IDC_CONDITION_UNIT_LABEL, 8, 106, 96, 8
    COMBOBOX IDC_CONDITION_UNIT, 108, 103, 264, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
