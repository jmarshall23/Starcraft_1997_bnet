    LTEXT "Settings are serialized to OWNR and SIDE and participate in Undo/Redo.", IDC_STATIC, 100, 108, 134, 30
    DEFPUSHBUTTON "OK", IDOK, 102, 148, 62, 14
    PUSHBUTTON "Cancel", IDCANCEL, 172, 148, 62, 14
END

