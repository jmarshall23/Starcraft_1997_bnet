    PUSHBUTTON "Edit", IDC_CONDITION_EDIT, 302, 242, 30, 14
    PUSHBUTTON "Delete", IDC_CONDITION_DELETE, 336, 242, 34, 14
    PUSHBUTTON "Up", IDC_CONDITION_UP, 374, 242, 26, 14
    PUSHBUTTON "Down", IDC_CONDITION_DOWN, 404, 242, 32, 14
