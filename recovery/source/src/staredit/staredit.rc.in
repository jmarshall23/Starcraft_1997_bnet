IDD_FORCES DIALOGEX 0, 0, 330, 222
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Forces"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "Players", IDC_STATIC, 8, 8, 40, 8
    LISTBOX IDC_FORCE_PLAYER_LIST, 8, 20, 82, 122, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    LTEXT "Force assignment:", IDC_STATIC, 8, 150, 68, 8
    COMBOBOX IDC_FORCE_ASSIGNMENT, 8, 162, 82, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Forces", IDC_STATIC, 102, 8, 40, 8
    LISTBOX IDC_FORCE_LIST, 102, 20, 72, 72, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_TABSTOP
    GROUPBOX "Selected Force", IDC_STATIC, 184, 8, 138, 134
    LTEXT "Name:", IDC_STATIC, 194, 25, 28, 8
    EDITTEXT IDC_FORCE_NAME, 194, 37, 116, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Random start location", IDC_FORCE_RANDOM_START, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 194, 61, 116, 10
    CONTROL "Allies", IDC_FORCE_ALLIES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 194, 78, 116, 10
    CONTROL "Allied victory", IDC_FORCE_ALLIED_VICTORY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 194, 95, 116, 10
    CONTROL "Shared vision", IDC_FORCE_SHARED_VISION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 194, 112, 116, 10
    LTEXT "This beta FORC layout stores assignments and names; force flags are unavailable.", IDC_FORCE_BETA_NOTE, 102, 150, 220, 25
    DEFPUSHBUTTON "OK", IDOK, 188, 198, 62, 14
    PUSHBUTTON "Cancel", IDCANCEL, 258, 198, 62, 14
END

IDD_SOUNDS DIALOGEX 0, 0, 360, 218
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
