#include <windows.h>
#include "resource.h"

IDI_STAREDIT_ICON ICON "@STAREDIT_ICON_RESOURCE_PATH@"

// Reconstructed exactly from EditLocal.dll:1200 ("New Scenario").
IDD_NEW_SCENARIO DIALOG DISCARDABLE 0, 0, 224, 157
STYLE DS_MODALFRAME | DS_CENTER | DS_3DLOOK | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Scenario"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 152, 8, 63, 14
    GROUPBOX "Scenario Size", IDC_STATIC, 8, 4, 135, 58
    LTEXT "&Width:", IDC_STATIC, 16, 16, 22, 8
    COMBOBOX IDC_NEW_WIDTH, 16, 28, 54, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Hei&ght:", IDC_STATIC, 80, 16, 24, 8
    COMBOBOX IDC_NEW_HEIGHT, 80, 28, 54, 73, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "&Square Map", IDC_NEW_SQUARE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 48, 60, 8
    GROUPBOX "Scenario Type", IDC_STATIC, 8, 68, 208, 80
    LTEXT "&Tileset:", IDC_STATIC, 16, 80, 24, 8
    LISTBOX IDC_NEW_TILESET, 16, 92, 92, 43, LBS_NOTIFY | LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Default Terrain:", IDC_STATIC, 116, 80, 50, 8
    CONTROL "", IDC_NEW_TERRAIN, "ListBox", LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP, 116, 92, 92, 43
    PUSHBUTTON "Cancel", IDCANCEL, 152, 24, 64, 14
    PUSHBUTTON "&Help", ID_HELP, 152, 40, 64, 14
END

IDD_UNIT_PROPERTIES DIALOGEX 0, 0, 320, 231
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Unit Properties"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "Unit:", IDC_STATIC, 8, 10, 28, 8
    LTEXT "", IDC_UNIT_NAME, 40, 10, 150, 10, SS_LEFTNOWORDWRAP
    LTEXT "Type ID:", IDC_STATIC, 8, 30, 34, 8
    EDITTEXT IDC_UNIT_TYPE, 44, 27, 48, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Player:", IDC_STATIC, 104, 30, 30, 8
    COMBOBOX IDC_UNIT_OWNER, 136, 27, 88, 96, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Position (pixels)", IDC_STATIC, 8, 50, 216, 42
    LTEXT "X:", IDC_STATIC, 20, 66, 10, 8
    EDITTEXT IDC_UNIT_X, 34, 63, 58, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Y:", IDC_STATIC, 112, 66, 10, 8
    EDITTEXT IDC_UNIT_Y, 126, 63, 58, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    GROUPBOX "Retail UNIT attributes", IDC_STATIC, 8, 98, 304, 96
    LTEXT "Hit points %:", IDC_STATIC, 18, 114, 54, 8
    EDITTEXT IDC_UNIT_HP, 76, 111, 38, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Shields %:", IDC_STATIC, 124, 114, 44, 8
    EDITTEXT IDC_UNIT_SHIELDS, 170, 111, 38, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Energy %:", IDC_STATIC, 216, 114, 38, 8
    EDITTEXT IDC_UNIT_ENERGY, 260, 111, 40, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Resources:", IDC_STATIC, 18, 136, 44, 8
    EDITTEXT IDC_UNIT_RESOURCES, 64, 133, 50, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Hangar:", IDC_STATIC, 124, 136, 34, 8
    EDITTEXT IDC_UNIT_HANGAR, 160, 133, 48, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "State flags:", IDC_STATIC, 18, 158, 44, 8
    EDITTEXT IDC_UNIT_STATE_FLAGS, 64, 155, 50, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Valid state:", IDC_STATIC, 124, 158, 44, 8
    EDITTEXT IDC_UNIT_VALID_STATE, 170, 155, 42, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Valid data:", IDC_STATIC, 218, 158, 38, 8
    EDITTEXT IDC_UNIT_VALID_DATA, 260, 155, 40, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "This beta UNIT record stores type, player, and position; retail-only fields are preserved but unavailable.", IDC_UNIT_BETA_NOTE, 18, 174, 282, 16
    DEFPUSHBUTTON "OK", IDOK, 178, 207, 62, 14
    PUSHBUTTON "Cancel", IDCANCEL, 248, 207, 62, 14
END

IDD_PLAYER_SETTINGS DIALOGEX 0, 0, 246, 170
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
